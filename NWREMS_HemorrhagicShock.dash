      "style": {
        "content": {
          "html": "<font size=\"5\">Primary Impression Criteria</font><br><div style=\"text-align: left;\">Any of:</div><ul style=\"\"><ul><li style=\"text-align: left;\"><span>Amputation of limb</span></li><li style=\"text-align: left;\"><font size=\"2\">Amputation of other parts of head (face, ears,etc.)</font></li><li style=\"text-align: left;\"><font size=\"2\">Gastrointestinal hemorrhage</font></li><li style=\"text-align: left;\"><font size=\"2\">Gastrostomy hemorrhage</font></li><li style=\"text-align: left;\"><font size=\"2\">Hemorrhage</font></li><li style=\"text-align: left;\"><font size=\"2\">Hemorrhagic Shock</font></li><li style=\"text-align: left;\"><font size=\"2\">Immediate postpartum hemorrhage</font></li><li style=\"text-align: left;\"><font size=\"2\">Labor and delivery complications</font></li><li style=\"text-align: left;\"><font size=\"2\">Laceration/Abrasion/Hematoma (minor surface trauma)</font></li><li style=\"text-align: left;\"><font size=\"2\">Postpartum hemorrhage</font></li><li style=\"text-align: left;\"><font size=\"2\">Tracheostomy Hemorrhage</font></li><li style=\"text-align: left;\"><font size=\"2\">Vaginal Hemorrhage</font></li></ul></ul>",
          "vAlign": "valign-middle",
          "bgColor": "#FFFFFF",
          "textAlign": "center"
        }
      },
      "instanceid": "5EF11-34F1-3A",
      "realTimeRefreshing": false,
      "options": {
