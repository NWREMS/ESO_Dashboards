          "html": "<br><div style=\"text-align: left;\"><span style=\"font-size: small;\">Age 0-9: Systolic blood pressure &lt; 70 + 2 * Age in years</span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\">Age 10-64: Systolic blood pressure &lt; 90 or Systolic blood pressure &lt; Pulse rate</span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\">Age 65+: Systolic blood pressure &lt; 110 or Systolic blood pressure &lt; Pulse rate</span><span style=\"font-size: small;\"></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: small;\"><br></span></div>",
