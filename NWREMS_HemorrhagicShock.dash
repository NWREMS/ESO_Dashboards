      "style": {
        "content": {
          "html": "<span style=\"font-size: 24px;\">Medical/Trauma Field Criteria</span><br><div style=\"text-align: left;\"><span style=\"text-align: -webkit-match-parent;\">Any of:</span><br><ul><li><span style=\"font-size: 12.5px;\">Trauma</span></li><li><span style=\"font-size: 12.5px;\">Medical &amp; Trauma</span></li></ul><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size: 12.5px;\"><br></span></div>",
          "vAlign": "valign-middle",
          "bgColor": "#FFFFFF",
          "textAlign": "center"
        }
      },
      "instanceid": "33BAA-D7DF-37",
