      "style": {
        "content": {
          "html": "<span style=\"font-size: x-large;\">Instructions</span><br><div style=\"text-align: left;\"><ol><li><font size=\"2\">In the pane below titled \"Hemorrhagic Shock Raw Data\", click the three-dot symbol and choose Download, then CSV File.&nbsp; This will download the raw data to a file in your Downloads folder named&nbsp;</font><span style=\"font-size: 12.5px;\">HemorrhagicShockRawData.csv.</span></li><li><span style=\"font-size: 12.5px;\">Open the accompanying Excel spreadsheet, titled Hemorrhagic Shock Dashboard.</span></li><li><span style=\"font-size: 12.5px;\">Select Data from the Excel ribbon, then Get Data, then Data Source Settings, then Change Source.</span></li><li><span style=\"font-size: 12.5px;\">In the Comma-Separated Values dialog, select Browse and and browse to the HemorrhagicShockRawData.csv file that you downloaded in Step 1.&nbsp; Click OK to return to the Data Source Setting dialog, then Close to return to the Data ribbon.</span></li><li><span style=\"font-size: 12.5px;\">Select Refresh All to load the new data.&nbsp; Select Refresh All again to update the table.</span></li></ol></div>",
          "vAlign": "valign-middle",
          "bgColor": "#FFFFFF",
          "textAlign": "center"
        }
